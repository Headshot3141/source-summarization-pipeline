# Python caches
__pycache__/
*.pyc

# Original source documents: large binaries that never change, and usually
# under copyright, so they never go into git
Sources/

# Rendered and intermediate outputs, rebuilt from Summary.md. The PDF and
# EPUB are named from TITLE in Work/build_pdf.py (Summary.pdf by default), so
# every PDF and EPUB at the project root is ignored.
/*.pdf
/*.epub
Work/summary.html

# Claude Code's per-user settings (they often hold absolute local paths) and
# the worktrees its sessions create
.claude/settings.local.json
.claude/worktrees/

# Local Python environments
.venv/
venv/
